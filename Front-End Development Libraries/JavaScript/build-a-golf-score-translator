const names = ['Hole-in-one!', 'Eagle', 'Birdie', 'Par', 'Bogey', 'Double Bogey', 'Go Home!'];

function golfScore(par, strokes) {
  if (strokes === 1) {
    return 'Hole-in-one!';
  } else if (strokes <= par - 2) {
    return 'Eagle';
  } else if (strokes === par - 1) {
    return 'Birdie';
  } else if (strokes === par) {
    return 'Par';
  } else if (strokes === par + 1) {
    return 'Bogey';
  } else if (strokes === par + 2) {
    return 'Double Bogey';
  } else {
    return 'Go Home!';
  }
}

console.log(golfScore(5, 4)); // Output: Birdie
console.log(golfScore(4, 3)); // Output: Birdie
console.log(golfScore(3, 5)); // Output: Go Home!
console.log(golfScore(4, 1)); // Output: Hole-in-one!
console.log(golfScore(5, 2)); // Output: Eagle
console.log(golfScore(4, 4)); // Output: Par
console.log(golfScore(4, 5)); // Output: Bogey
